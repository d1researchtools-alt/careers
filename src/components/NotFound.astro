---
// Temporary "this isn't a real page" notice, wrapped by the live chrome.
---

<section class="notice">
  <p class="code">404</p>
  <h1>This page isn't live</h1>
  <p class="lead">
    You've reached a temporary development site. There's no real content here —
    it's only being used to test the design1st.com header and footer.
  </p>
  <p>
    Looking for the real thing? Head to
    <a href="https://design1st.com">design1st.com</a>.
  </p>
</section>

<style>
  .notice {
    max-width: 40rem;
    margin: 0 auto;
    padding: 5rem 1.25rem 6rem;
    text-align: center;
  }
  .code {
    font-size: clamp(4rem, 14vw, 8rem);
    font-weight: 800;
    line-height: 1;
    margin: 0 0 0.5rem;
    color: #e8562a; /* design1st orange */
    letter-spacing: -0.02em;
  }
  .notice h1 {
    font-size: 1.75rem;
    margin: 0 0 1rem;
  }
  .lead {
    font-size: 1.125rem;
  }
  .notice p {
    margin: 0 0 1rem;
    line-height: 1.6;
  }
  .notice a {
    color: #e8562a;
    font-weight: 600;
  }
</style>
