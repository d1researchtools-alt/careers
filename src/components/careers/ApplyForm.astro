---
// The "Job Request Form" — Gravity Forms form #2, rebuilt.
//
// Text fields post as JSON to /api/apply, which forwards them into WordPress
// and reports back in plain JSON (same pattern as the header's contact
// modals). Files are different: they go from the browser STRAIGHT to Gravity
// Forms' own upload endpoint, because Vercel caps a function's request body at
// 4.5 MB and the form promises 15 MB per file. See src/pages/api/apply.ts for
// the full reasoning; the short version is that design1st.com/?gf_page=… is
// the same origin as design1st.com/careers, so the browser can post to it and
// read the answer, which is exactly what the WordPress widget does too.
//
// Off design1st.com (astro dev, a *.vercel.app staging URL) that endpoint is
// cross-origin, so the script falls back to /api/upload — a proxy with the
// 4.5 MB cap. Good enough to test with a resume; not the production path.
import { UPLOAD_RULES } from "@/lib/gravity"

// The app is mounted under a base path (/careers in production), so the API
// routes have to be resolved against it rather than the page URL.
const API = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/api`

/** The Discipline select. /api/apply maps each onto a field 10 choice. */
const DISCIPLINES = [
  "Mechanical engineering",
  "Industrial design",
  "Electronics engineering",
  "Embedded software",
  "Manufacturing",
  "Other",
]

const ACCEPT = UPLOAD_RULES.extensions.map((e) => `.${e}`).join(",")
const RULES = {
  maxFiles: UPLOAD_RULES.maxFiles,
  maxBytes: UPLOAD_RULES.maxBytes,
  extensions: UPLOAD_RULES.extensions,
}
const MAX_MB = Math.round(UPLOAD_RULES.maxBytes / 1024 / 1024)
const TYPES = UPLOAD_RULES.extensions.map((e) => e.toUpperCase())
const TYPES_TEXT = `${TYPES.slice(0, -1).join(", ")} or ${TYPES.at(-1)}`
---

{
  /* Every field is required. Errors are keyed by data-gf: Gravity Forms field
     ids where the field exists on form #2, a name where it does not (the
     discipline detail and the work link travel inside field 11). */
}
<form class="cr-form" data-apply-form novalidate aria-label="Job application">
  <div class="cr-form__row">
    <div class="cr-field" data-gf="9.3">
      <label for="cr-first">First Name</label>
      <input id="cr-first" name="firstName" autocomplete="given-name" required />
    </div>
    <div class="cr-field" data-gf="9.6">
      <label for="cr-last">Last Name</label>
      <input id="cr-last" name="lastName" autocomplete="family-name" required />
    </div>
  </div>

  <div class="cr-form__row">
    <div class="cr-field" data-gf="1">
      <label for="cr-email">Email</label>
      <input id="cr-email" name="email" type="email" autocomplete="email" inputmode="email" required />
    </div>
    <div class="cr-field" data-gf="8">
      <label for="cr-phone">Phone</label>
      <input id="cr-phone" name="phone" type="tel" autocomplete="tel" required />
    </div>
  </div>

  <div class="cr-field" data-gf="10">
    <label for="cr-discipline">Discipline</label>
    <select id="cr-discipline" name="discipline" required>
      {DISCIPLINES.map((d, i) => <option value={d} selected={i === 0}>{d}</option>)}
    </select>
  </div>

  <div class="cr-field" data-gf="disciplineOther" data-other hidden>
    <label for="cr-discipline-other">Your Discipline</label>
    <input id="cr-discipline-other" name="disciplineOther" required disabled />
  </div>

  <div class="cr-field" data-gf="3">
    <span class="cr-label" id="cr-files-label">Résumé or Portfolio</span>
    <div class="cr-upload" data-drop>
      <input
        type="file"
        id="cr-files"
        data-file-input
        accept={ACCEPT}
        multiple
        aria-labelledby="cr-files-label"
        aria-describedby="cr-files-rules"
      />
      <label for="cr-files" class="cr-upload__btn">Choose Files</label>
      <span class="cr-upload__name" data-file-summary aria-live="polite">No file selected</span>
    </div>
    <p class="cr-hint" id="cr-files-rules">
      {TYPES_TEXT}. Up to {UPLOAD_RULES.maxFiles} files, {MAX_MB} MB each.
    </p>
    <ul class="cr-files__list" data-file-list role="list"></ul>
  </div>

  <div class="cr-field" data-gf="workUrl">
    <label for="cr-work">Link to Your Work</label>
    <input id="cr-work" name="workUrl" type="url" placeholder="https://" inputmode="url" required />
  </div>

  <div class="cr-field" data-gf="11">
    <label for="cr-why">Why do you want to work at Design 1st?</label>
    <textarea id="cr-why" name="why" rows="5" required></textarea>
  </div>

  {
    /* Honeypot. Form #2's own decoy is the "X/Twitter" field; Gravity Forms
       silently discards submissions that fill it and /api/apply does the
       same. Off-screen rather than display:none so naive bots still see it. */
  }
  <div class="cr-form__hp" aria-hidden="true">
    <label>
      X/Twitter
      <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <button type="submit" class="cr-btn cr-btn--block">Submit Application</button>
  <p class="cr-form__status" data-status role="status" aria-live="polite"></p>
</form>

<div class="cr-done" data-done hidden tabindex="-1">
  <h2 class="cr-done__title">Application received</h2>
  <p class="cr-done__text" data-done-text></p>
</div>

<script is:inline define:vars={{ API, RULES }}>
  ;(() => {
    const root = document.querySelector("[data-apply-form]")
    if (!root) return
    const form = root
    const status = form.querySelector("[data-status]")
    const submit = form.querySelector("button[type=submit]")
    const drop = form.querySelector("[data-drop]")
    const input = form.querySelector("[data-file-input]")
    const list = form.querySelector("[data-file-list]")
    const summary = form.querySelector("[data-file-summary]")
    const done = document.querySelector("[data-done]")
    const discipline = form.querySelector("#cr-discipline")
    const otherWrap = form.querySelector("[data-other]")
    const other = form.querySelector("#cr-discipline-other")

    // "Other" reveals a text field for the discipline name.
    const syncOther = () => {
      otherWrap.hidden = discipline.value !== "Other"
      other.disabled = otherWrap.hidden
    }
    discipline.addEventListener("change", syncOther)
    syncOther()

    // A role's Apply button pre-selects its discipline.
    document.querySelectorAll("[data-discipline]").forEach((a) =>
      a.addEventListener("click", () => {
        discipline.value = a.getAttribute("data-discipline")
        syncOther()
      }),
    )

    // Only on design1st.com is Gravity Forms' upload endpoint same-origin.
    // Anywhere else, go through the proxy (4.5 MB cap — see /api/upload).
    const DIRECT = location.hostname === "design1st.com"

    // One id ties the temp files to the submission that claims them. Gravity
    // Forms wants it alphanumeric; the widget's own is a 32-char hex string.
    const uniqueId = Array.from(crypto.getRandomValues(new Uint8Array(16)), (b) =>
      b.toString(16).padStart(2, "0"),
    ).join("")

    const say = (state, text) => {
      status.dataset.state = state
      status.textContent = text
    }
    const fmtSize = (n) => (n < 1024 * 1024 ? `${Math.round(n / 1024)} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`)
    const ext = (name) => (name.match(/\.([a-z0-9]+)$/i)?.[1] || "").toLowerCase()

    // ---- upload config -----------------------------------------------------
    // Fetched once, the first time a file is added. It carries a nonce that is
    // good for 24 hours, so a form left open overnight can still upload.
    let config = null
    const getConfig = async () => {
      if (config) return config
      const res = await fetch(`${API}/apply`, { cache: "no-store" })
      const out = await res.json()
      if (!out.ok) throw new Error(out.message || "Upload is unavailable right now.")
      config = out
      return config
    }

    // ---- files ---------------------------------------------------------------
    /** @type {{file: File, li: HTMLElement, state: "uploading"|"done"|"error", pct: number, xhr?: XMLHttpRequest, temp_filename?: string, uploaded_filename?: string, promise: Promise<void>}[]} */
    const files = []

    const render = (entry) => {
      const { li, file, state, pct } = entry
      li.dataset.state = state
      li.querySelector("[data-name]").textContent = file.name
      li.querySelector("[data-size]").textContent = fmtSize(file.size)
      const label = li.querySelector("[data-file-status]")
      const bar = li.querySelector("[data-bar]")
      if (state === "uploading") {
        label.textContent = pct < 100 ? `Uploading… ${pct}%` : "Processing…"
        bar.style.width = `${pct}%`
      } else if (state === "done") {
        label.textContent = "Attached"
        bar.style.width = "100%"
      } else {
        label.textContent = entry.error || "Upload failed"
        bar.style.width = "0"
      }
    }

    const summarise = () => {
      summary.textContent = files.length ? files.map((f) => f.file.name).join(", ") : "No file selected"
    }

    const remove = (entry) => {
      entry.xhr?.abort()
      files.splice(files.indexOf(entry), 1)
      entry.li.remove()
      summarise()
      // A temp file left behind on the server is purged by Gravity Forms on its
      // own schedule; the submission only claims the ones still listed here.
    }

    // The same multipart body plupload sends, minus plupload.
    const upload = (entry) =>
      new Promise(async (resolve) => {
        let cfg
        try {
          cfg = await getConfig()
        } catch (err) {
          entry.state = "error"
          entry.error = "Upload is unavailable right now"
          render(entry)
          return resolve()
        }
        const body = new FormData()
        body.append("name", entry.file.name)
        body.append("form_id", cfg.formId)
        body.append("field_id", cfg.fieldId)
        body.append("gform_unique_id", uniqueId)
        if (DIRECT) body.append(`_gform_file_upload_nonce_${cfg.formId}_${cfg.fieldId}`, cfg.nonce)
        body.append("file", entry.file, entry.file.name)

        const xhr = new XMLHttpRequest()
        entry.xhr = xhr
        xhr.open("POST", DIRECT ? cfg.uploadUrl : `${API}/upload`)
        xhr.upload.onprogress = (e) => {
          if (!e.lengthComputable) return
          entry.pct = Math.round((e.loaded / e.total) * 100)
          render(entry)
        }
        xhr.onerror = () => {
          entry.state = "error"
          entry.error = "Upload failed — check your connection"
          render(entry)
          resolve()
        }
        xhr.onabort = () => resolve()
        xhr.onload = () => {
          let out = null
          try {
            out = JSON.parse(xhr.responseText)
          } catch {}
          if (xhr.status === 200 && out && out.status === "ok" && out.data?.temp_filename) {
            entry.state = "done"
            entry.temp_filename = out.data.temp_filename
            entry.uploaded_filename = out.data.uploaded_filename || entry.file.name
          } else {
            entry.state = "error"
            entry.error = out?.error?.message || `Upload failed (${xhr.status})`
          }
          render(entry)
          resolve()
        }
        xhr.send(body)
      })

    const addFiles = (incoming) => {
      say("", "")
      for (const file of Array.from(incoming)) {
        if (files.length >= RULES.maxFiles) {
          say("error", `You can attach up to ${RULES.maxFiles} files.`)
          break
        }
        if (!RULES.extensions.includes(ext(file.name))) {
          say("error", `${file.name}: only ${RULES.extensions.map((e) => e.toUpperCase()).join(", ")} files are accepted.`)
          continue
        }
        if (file.size > RULES.maxBytes) {
          say("error", `${file.name} is larger than ${Math.round(RULES.maxBytes / 1024 / 1024)} MB.`)
          continue
        }
        if (files.some((f) => f.file.name === file.name && f.file.size === file.size)) continue

        const li = document.createElement("li")
        li.className = "cr-file"
        li.innerHTML =
          '<span class="cr-file__name" data-name></span>' +
          '<span class="cr-file__size" data-size></span>' +
          '<span class="cr-file__status" data-file-status></span>' +
          '<button type="button" class="cr-file__remove" aria-label="Remove file">&times;</button>' +
          '<span class="cr-file__bar" aria-hidden="true"><span data-bar></span></span>'
        const entry = { file, li, state: "uploading", pct: 0 }
        li.querySelector("button").addEventListener("click", () => remove(entry))
        list.appendChild(li)
        files.push(entry)
        render(entry)
        entry.promise = upload(entry)
      }
      input.value = ""
      summarise()
    }

    input.addEventListener("change", () => addFiles(input.files))
    ;["dragenter", "dragover"].forEach((t) =>
      drop.addEventListener(t, (e) => {
        e.preventDefault()
        drop.classList.add("is-over")
      }),
    )
    ;["dragleave", "drop"].forEach((t) =>
      drop.addEventListener(t, (e) => {
        e.preventDefault()
        drop.classList.remove("is-over")
      }),
    )
    drop.addEventListener("drop", (e) => addFiles(e.dataTransfer?.files || []))

    // ---- submit --------------------------------------------------------------
    // Gravity Forms field id → the block to flag. Server errors come back keyed
    // by field id so the same map serves both local and WordPress validation.
    // WordPress reports the name as field "9"; the page splits it into 9.3/9.6.
    const block = (id) => form.querySelector(`[data-gf="${id}"]`) || form.querySelector(`[data-gf^="${id}."]`)
    // DOM order, not key order: JS puts integer-like keys ("1", "11") first.
    const focusFirst = () =>
      form.querySelector(".is-invalid")?.querySelector("input:not([type=file]), select, textarea, .cr-upload__btn")?.focus()
    const clearErrors = () => {
      form.querySelectorAll("[data-gf].is-invalid").forEach((el) => el.classList.remove("is-invalid"))
      form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"))
      form.querySelectorAll(".cr-field__error").forEach((el) => el.remove())
    }
    const flag = (id, message) => {
      const el = block(id)
      if (!el) return
      el.classList.add("is-invalid")
      el.querySelectorAll("input:not([type=file]), select, textarea").forEach((c) => c.setAttribute("aria-invalid", "true"))
      if (message) {
        const p = document.createElement("p")
        p.className = "cr-field__error"
        p.textContent = message
        el.appendChild(p)
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault()
      clearErrors()

      const data = new FormData(form)
      const val = (k) => String(data.get(k) || "").trim()
      const email = val("email")
      const workUrl = val("workUrl")
      const local = {}
      if (!val("firstName")) local["9.3"] = "Please enter your first name."
      if (!val("lastName")) local["9.6"] = "Please enter your last name."
      if (!email) local["1"] = "Please enter your email address."
      else if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) local["1"] = "That doesn't look like an email address."
      if (!val("phone")) local["8"] = "Please enter your phone number."
      if (discipline.value === "Other" && !val("disciplineOther")) local.disciplineOther = "Please tell us your discipline."
      if (!files.length) local["3"] = "Please attach your résumé or portfolio."
      if (!workUrl) local.workUrl = "Please add a link to your work."
      else if (!/^https?:\/\/\S+\.\S+/i.test(workUrl)) local.workUrl = "Please enter a full link, starting with https://"
      if (!val("why")) local["11"] = "Please tell us why you want to work at Design 1st."
      if (Object.keys(local).length) {
        Object.entries(local).forEach(([id, msg]) => flag(id, msg))
        say("error", "Please check the highlighted fields.")
        focusFirst()
        return
      }
      if (files.some((f) => f.state === "error")) {
        flag("3")
        say("error", "One of your files didn't upload. Remove it, or try attaching it again.")
        return
      }

      submit.disabled = true
      if (files.some((f) => f.state === "uploading")) {
        say("", "Finishing your file upload…")
        await Promise.all(files.map((f) => f.promise))
        if (files.some((f) => f.state !== "done")) {
          submit.disabled = false
          flag("3")
          say("error", "One of your files didn't upload. Remove it, or try attaching it again.")
          return
        }
      }

      say("", "Sending…")
      try {
        const res = await fetch(`${API}/apply`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            firstName: data.get("firstName"),
            lastName: data.get("lastName"),
            email,
            phone: data.get("phone"),
            discipline: discipline.value,
            disciplineOther: data.get("disciplineOther"),
            workUrl,
            why: val("why"),
            files: files.map((f) => ({ temp_filename: f.temp_filename, uploaded_filename: f.uploaded_filename })),
            uniqueId,
            honeypot: data.get("honeypot"),
          }),
        })
        const out = await res.json()
        if (out.ok) {
          say("", "")
          form.hidden = true
          done.querySelector("[data-done-text]").textContent = out.message
          done.hidden = false
          done.focus()
          return
        }
        if (out.fieldErrors) {
          Object.entries(out.fieldErrors).forEach(([id, msg]) => flag(id, msg))
          focusFirst()
        }
        say("error", out.message)
      } catch {
        say("error", "Something went wrong. Please try again, or email info@design1st.com.")
      } finally {
        submit.disabled = false
      }
    })
  })()
</script>
