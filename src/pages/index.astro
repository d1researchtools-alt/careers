---
// /careers — the page. Hero, stats, who we are, open positions, the
// application form, the photo grid. Layout and copy follow the designer
// handoff of 2026-09-24; the gallery is the Elementor original's.
//
// This file COMPOSES. Every colour, size and space lives in
// src/styles/careers.css; if something here looks like it needs a hex, a
// class is missing there.
import Layout from "@/layouts/Layout.astro"
import Icon from "@/components/ui/Icon.astro"
import ApplyForm from "@/components/careers/ApplyForm.astro"
import { withBase, CANONICAL, SITE_ORIGIN } from "@/lib/paths"
import "@/styles/careers.css"

// <title> and description are the WordPress page's, verbatim: this is a move,
// not a rewrite, and the ranking surface should not change with the host.
const TITLE = "Careers - Design 1st"
const DESCRIPTION =
  "Work alongside the industry's most innovative minds on high-impact projects that bring creative solutions to new products."

// og:image stays on WordPress on purpose. It is the file every existing share
// of this URL has cached, it lives under /wp-content (outside the Worker's
// route, so WordPress keeps serving it), and JPEG is the safe format for link
// previews where WebP still is not.
const OG_IMAGE = `${SITE_ORIGIN}/wp-content/uploads/2023/02/design1st-team-with-waterot.jpg`

// The company video fills the hero's media slot. youtube-nocookie keeps the
// embed from setting cookies until someone presses play.
const VIDEO_ID = "TXJmzmvk98Q"

const STATS = [
  { n: "30", label: "Years in business" },
  { n: "1,200+", label: "Products developed" },
  { n: "130+", label: "Client patents secured" },
  { n: "16", label: "Market segments" },
]

// Open roles. Empty the array and the section shows the "no open positions"
// message instead. `discipline` must be one of ApplyForm's DISCIPLINES: the
// role's Apply button pre-selects it in the form.
const ROLES: {
  title: string
  meta: string
  discipline: string
  summary: string
  requirements: string[]
  niceToHave: string[]
}[] = [
  {
    title: "Senior Mechanical Product Design Engineer",
    meta: "Ottawa · Full time · On site",
    discipline: "Mechanical engineering",
    summary:
      "Lead mechanical design from concept to manufacturing, working with clients and our industrial design, electronics and software teams.",
    requirements: [
      "7+ years in physical product design",
      "Mechanical engineering degree",
      "5+ years in SolidWorks",
      "Based in or relocating to Ottawa",
    ],
    niceToHave: [
      "Experience with volume manufacturing processes",
      "An understanding of how design creates value for end users",
    ],
  },
]

const img = (name: string, w: number) => withBase(`/static/images/careers/${name}-${w}.webp`)

// Captions are the live page's. Alt text is new — the originals had none.
const GALLERY = [
  { name: "gallery-01", caption: "Prototype Building and Testing", alt: "Two engineers assembling a large white prototype frame in the workshop" },
  { name: "gallery-02", caption: "Manufacturing Partners in China", alt: "The Design 1st team with a manufacturing partner's staff outside their facility in Shenzhen" },
  { name: "gallery-03", caption: "Engineering and Design Team", alt: "Two engineers in blue lab coats working at a bench with hand tools" },
  { name: "gallery-04", caption: "Partnering with Leading Innovators", alt: "Four team members in the office holding a circuit board" },
  { name: "gallery-05", caption: "VP's Give a Tour of the Offices", alt: "Two people pointing at the Design 1st conference room sign" },
  { name: "gallery-06", caption: "Product Testing with the Waterotor Tech Team", alt: "The team standing behind a blue Waterotor turbine prototype in a field" },
]
---

<Layout title={TITLE} description={DESCRIPTION} canonical={CANONICAL} ogImage={OG_IMAGE} ogType="website" wide>
  <div class="d1-page cr">
    <section class="cr-hero">
      <div class="cr-wrap cr-hero__grid">
        <div class="cr-hero__copy">
          <nav class="cr-crumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href={`${SITE_ORIGIN}/`}>Design 1st</a></li>
              <li><span>About</span></li>
              <li><span aria-current="page">Careers</span></li>
            </ol>
          </nav>

          <div class="cr-clutch">
            <img src={withBase("/chrome/clutch.svg")} width="80" height="24" alt="Clutch" />
            <span class="cr-clutch__score">4.7</span>
            <span class="cr-clutch__stars" role="img" aria-label="4.7 out of 5 stars">
              {Array.from({ length: 5 }, () => <Icon name="star" />)}
            </span>
          </div>

          <h1>Design 1st Careers</h1>
          <p class="cr-hero__lede">
            We’re always looking for creative people who want to take hardware from first sketch to production.
          </p>
          <a class="cr-btn cr-btn--hero" href="#openings">See Open Positions</a>
        </div>

        <div class="cr-video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${VIDEO_ID}?rel=0`}
            title="Design 1st: product design and engineering"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
      </div>
    </section>

    <section class="cr-stats" aria-label="Design 1st at a glance">
      <div class="cr-wrap cr-stats__grid">
        {
          STATS.map((s) => (
            <div class="cr-stat">
              <div class="cr-stat__n">{s.n}</div>
              <div class="cr-stat__l">{s.label}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="cr-section cr-band">
      <div class="cr-wrap cr-about">
        <div>
          <h2 class="cr-h3">Who We Are</h2>
          <p>
            Design 1st is a product design and engineering firm in Ottawa. Industrial design, mechanical and electronics
            engineering, embedded software, prototyping and manufacturing support all work under one roof, so the people
            who design a product stay with it all the way to production.
          </p>
        </div>
        <div>
          <h2 class="cr-h3">Who We’re Looking For</h2>
          <p>
            People who enjoy hard problems and want to own them. You’ll work on several products across different
            industries, side by side with the other disciplines, and you’ll see the parts you design built, tested and
            manufactured.
          </p>
        </div>
      </div>
    </section>

    <section class="cr-section" id="openings">
      <div class="cr-wrap">
        <div class="cr-head"><h2>Open Positions</h2></div>

        {
          ROLES.length ? (
            <div class="cr-roles">
              {ROLES.map((r) => (
                <article class="cr-role">
                  <header class="cr-role__head">
                    <div>
                      <h3 class="cr-role__title">{r.title}</h3>
                      <p class="cr-role__meta">{r.meta}</p>
                    </div>
                    <a class="cr-btn" href="#apply" data-discipline={r.discipline}>
                      Apply Today
                    </a>
                  </header>
                  <p class="cr-role__summary">{r.summary}</p>
                  <div class="cr-role__cols">
                    <div>
                      <h4 class="cr-role__sub">Requirements</h4>
                      <ul class="cr-role__reqs">
                        {r.requirements.map((x) => (
                          <li>{x}</li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <h4 class="cr-role__sub">Nice to have</h4>
                      <ul class="cr-role__reqs cr-role__reqs--plus">
                        {r.niceToHave.map((x) => (
                          <li>{x}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="cr-empty">
              <p>No open positions right now. You can still send us your work below.</p>
            </div>
          )
        }
      </div>
    </section>

    <section class="cr-section cr-band" id="apply">
      <div class="cr-wrap">
        <div class="cr-head">
          <h2>Apply Today</h2>
          <p>
            We hire talented, passionate professionals into a supportive workplace that our team makes better and our
            clients love. Our integrated team manages every step of our client’s product development process, from
            concept through to electronics design, manufacturing setup, and production support.
          </p>
          <p>We keep all job requests on file and review applications frequently. All fields are required.</p>
        </div>
        <ApplyForm />
      </div>
    </section>

    <section class="cr-gallery">
      <div class="cr-wrap">
        <h2>The Design Team at Work and Play!</h2>
        <ul class="cr-gallery__grid" role="list">
          {
            GALLERY.map((g) => (
              <li>
                <figure>
                  <img
                    src={img(g.name, 523)}
                    srcset={`${img(g.name, 1046)} 1046w, ${img(g.name, 523)} 523w`}
                    sizes="(min-width: 900px) 523px, 100vw"
                    width="523"
                    height="342"
                    alt={g.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{g.caption}</figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Layout>
